-size_t page_size() { return getpagesize(); }
-size_t allocation_granularity() { return page_size(); }
+size_t page_size() {
+#if XE_PLATFORM_GNU_LINUX
+  // Xbox360PS5: exercise guest heaps and access watches with the console's
+  // coarser pages on a Linux host. This changes Xenia's bookkeeping only;
+  // Linux still supplies its actual native mappings. Production defaults
+  // to the real page size.
+  static const size_t size = [] {
+    const size_t native = getpagesize();
+    const char* text = std::getenv("XBOX360PS5_HOST_PAGE_SIZE");
+    const size_t requested = text ? std::strtoull(text, nullptr, 0) : native;
+    return requested == 16384 && native <= requested ? requested : native;
+  }();
+  return size;
+#else
+  return getpagesize();
+#endif
+}
+size_t allocation_granularity() {
+  // Xbox360PS5: XE_ALLOCATION_GRANULARITY=<bytes> makes a PC behave like a
+  // host whose mappings are coarser than 4 KiB (the PS5: 16 KiB; Windows:
+  // 64 KiB), which changes how the guest's 0xE0000000 range is mapped. For
+  // reproducing console-only behaviour on a PC.
+  static const size_t granularity = [] {
+    const char* text = std::getenv("XE_ALLOCATION_GRANULARITY");
+    const size_t value = text ? std::strtoull(text, nullptr, 0) : 0;
+    return value >= page_size() ? value : page_size();
+  }();
+  return granularity;
+}
 

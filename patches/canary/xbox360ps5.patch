+// a later invalidation (textures, converted index buffers, resolves, GPU-written
+// data) asks without allow_unwatched or registers a watch, and its units are
+// pinned: watched as before, and never left unwatched again.
+namespace {
+constexpr uint8_t kHeatToUnwatch = 3;
+constexpr uint8_t kHeatWhenUnwatched = 32;
+inline bool UnitBit(const std::vector<uint64_t>& bits, uint32_t unit) {
+  return (__atomic_load_n(&bits[unit >> 6], __ATOMIC_RELAXED) >> (unit & 63)) &
+         1;
+}
+inline void SetUnitBit(std::vector<uint64_t>& bits, uint32_t unit) {
+  __atomic_fetch_or(&bits[unit >> 6], uint64_t(1) << (unit & 63),
+                    __ATOMIC_RELAXED);
+}
+inline void ClearUnitBit(std::vector<uint64_t>& bits, uint32_t unit) {
+  __atomic_fetch_and(&bits[unit >> 6], ~(uint64_t(1) << (unit & 63)),
+                     __ATOMIC_RELAXED);
+}
+}  // namespace
+
+bool SharedMemory::UnwatchedPagesEnabled() const {
+  return xbox360ps5::gpu_diag::enabled.load(std::memory_order_relaxed) &&
+         xbox360ps5::gpu_diag::unwatched_pages.load(std::memory_order_relaxed);
+}
+
+// A write fault on these units (global lock held).
+void SharedMemory::NoteCpuWrite(uint32_t page_first, uint32_t page_last) {
+  for (uint32_t unit = page_first; unit <= page_last; ++unit) {
+    if (UnitBit(pinned_bits_, unit)) {
+      continue;
+    }
+    uint8_t& heat = unit_heat_[unit];
+    if (heat < UINT8_MAX) {
+      ++heat;
+    }
+    if (heat >= kHeatToUnwatch && !UnitBit(unwatched_bits_, unit)) {
+      ClearUnitBit(unwatched_seen_bits_, unit);
+      SetUnitBit(unwatched_bits_, unit);
+      heat = kHeatWhenUnwatched;
+      unwatched_heated_.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+}
+
+// The guest released or reprotected these units (global lock held).
+void SharedMemory::ForgetUnwatched(uint32_t page_first, uint32_t page_last) {
+  for (uint32_t unit = page_first; unit <= page_last; ++unit) {
+    unit_heat_[unit] = 0;
+    ClearUnitBit(unwatched_bits_, unit);
+    ClearUnitBit(unwatched_seen_bits_, unit);
+  }
+}
+
+// Something will depend on these units' watch (global lock held). A pinned
+// unit is never left unwatched again, so one already pinned has nothing to
+// clear.
+void SharedMemory::PinWatched(uint32_t page_first, uint32_t page_last) {
+  for (uint32_t unit = page_first; unit <= page_last; ++unit) {
+    if (UnitBit(pinned_bits_, unit)) {
+      continue;
+    }
+    SetUnitBit(pinned_bits_, unit);
+    ClearUnitBit(unwatched_bits_, unit);
+    ClearUnitBit(unwatched_seen_bits_, unit);
+    unit_heat_[unit] = 0;
+  }
+}
+
+// Of the units a request found invalid, drops the unwatched ones whose bytes
+// are what the GPU copy already holds. GPU thread, no lock: a unit that is
+// being left unwatched right now is treated as watched and uploaded.
+unsigned int SharedMemory::FilterUnwatched(
+    std::pair<uint32_t, uint32_t>*& uploads, unsigned int count) {
+  bool any = false;
+  for (unsigned int i = 0; i < count && !any; ++i) {
+    for (uint32_t unit = uploads[i].first;
+         unit < uploads[i].first + uploads[i].second; ++unit) {
+      if (UnitBit(unwatched_bits_, unit)) {
+        any = true;
+        break;
+      }
+    }
+  }
+  if (!any) {
+    return count;
+  }
+  unwatched_filtered_.clear();
+  const size_t unit_bytes = size_t(1) << page_size_log2_;
+  for (unsigned int i = 0; i < count; ++i) {
+    uint32_t run_start = UINT32_MAX;
+    const uint32_t end = uploads[i].first + uploads[i].second;
+    for (uint32_t unit = uploads[i].first; unit < end; ++unit) {
+      bool upload = true;
+      if (UnitBit(unwatched_bits_, unit)) {
+        const uint64_t hash = XXH3_64bits(
+            memory().TranslatePhysical(unit << page_size_log2_), unit_bytes);
+        if (UnitBit(unwatched_seen_bits_, unit) && unit_hash_[unit] == hash) {
+          upload = false;
+          ++unwatched_skips_;
+        } else {
+          // Taken before the copy: a write in between leaves the guest's
+          // bytes different from this hash, and the next request uploads.
+          unit_hash_[unit] = hash;
+          SetUnitBit(unwatched_seen_bits_, unit);
+          ++unwatched_uploads_;
+        }
+      }
+      if (upload) {
+        if (run_start == UINT32_MAX) {
+          run_start = unit;
+        }
+      } else if (run_start != UINT32_MAX) {
+        unwatched_filtered_.emplace_back(run_start, unit - run_start);
+        run_start = UINT32_MAX;
+      }
+    }
+    if (run_start != UINT32_MAX) {
+      unwatched_filtered_.emplace_back(run_start, end - run_start);
+    }
+  }
+  uploads = unwatched_filtered_.data();
+  return static_cast<unsigned int>(unwatched_filtered_.size());
+}
+
+// Every 120 guest frames: heat halves, and an unwatched unit whose heat has
+// run out goes back to being watched at its next upload.
+void SharedMemory::AgeUnwatchedPages() {
+  auto global_lock = global_critical_region_.Acquire();
+  const size_t units = unit_heat_.size();
+  for (size_t base = 0; base < units; base += 8) {
+    uint64_t eight;
+    std::memcpy(&eight, &unit_heat_[base], sizeof(eight));
+    if (!eight) {
+      continue;
+    }
+    for (size_t unit = base; unit < base + 8; ++unit) {
+      uint8_t& heat = unit_heat_[unit];
+      if (!heat) {
+        continue;
+      }
+      heat >>= 1;
+      if (heat < 2 && UnitBit(unwatched_bits_, uint32_t(unit))) {
+        ClearUnitBit(unwatched_bits_, uint32_t(unit));
+        ClearUnitBit(unwatched_seen_bits_, uint32_t(unit));
+        unwatched_cooled_.fetch_add(1, std::memory_order_relaxed);
+      }
+    }
+  }
+}

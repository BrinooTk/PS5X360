+// Xbox360PS5: skeleton frames for the title, from the estimated pose.
+// The title's NUI library finds bodies with GPU passes that end in copy
+// commands the emulator does not have (copy command 2 and whole lists of
+// rectangles), so the frames it builds never hold a body, whatever the depth
+// picture shows. The title's NuiSkeletonGetNextFrame is answered here instead,
+// one frame per sensor period.
+constexpr uint32_t kSkeletonPeriodMs = 33;
+// The library's own limit for a wait.
+constexpr uint32_t kSkeletonLongestWaitMs = 8000;
+constexpr X_HRESULT kSkeletonInvalidArgument = 0x80070057;
+// What the library returns when its wait for a frame ends without one.
+constexpr X_HRESULT kSkeletonNoFrameYet = 0x8000000A;
+
+struct SkeletonSource {
+  std::mutex mutex;
+  std::chrono::steady_clock::time_point start =
+      std::chrono::steady_clock::now();
+  uint32_t delivered_period = 0;
+  // Names the body in the frames. A body that comes back after being lost is
+  // a new one for the title, as with the sensor.
+  uint32_t tracking_id = 0;
+  bool tracked = false;
+};
+SkeletonSource g_skeleton_source;
+
+X_HRESULT SkeletonGetNextFrame(KernelState* kernel_state, uint32_t wait_ms,
+                               uint32_t frame_ptr) {
+  using clock = std::chrono::steady_clock;
+  Memory* memory = kernel_state->memory();
+  if (!IsGuestRangeMapped(memory, frame_ptr,
+                          xbox360ps5::motion::kSkeletonFrameBytes, true)) {
+    return kSkeletonInvalidArgument;
+  }
+  SkeletonSource& source = g_skeleton_source;
+  const auto period_now = [&source] {
+    return uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                        clock::now() - source.start)
+                        .count() /
+                    kSkeletonPeriodMs) +
+           1;
+  };
+  const auto deadline =
+      clock::now() + std::chrono::milliseconds(
+                         std::min(wait_ms, kSkeletonLongestWaitMs));
+  std::unique_lock<std::mutex> lock(source.mutex);
+  uint32_t period = period_now();
+  // A second request within one period waits for the next frame.
+  while (period == source.delivered_period) {
+    if (clock::now() >= deadline) {
+      return kSkeletonNoFrameYet;
+    }
+    lock.unlock();
+    xe::threading::Sleep(std::chrono::milliseconds(1));
+    lock.lock();
+    period = period_now();
+  }
+  source.delivered_period = period;
+  const xbox360ps5::motion::Frame pose = xbox360ps5::motion::Snapshot();
+  if (pose.tracked && !source.tracked && !++source.tracking_id) {
+    source.tracking_id = 1;
+  }
+  source.tracked = pose.tracked;
+  xbox360ps5::motion::WriteSkeletonFrame(
+      memory->TranslateVirtual(frame_ptr), pose, period,
+      uint64_t(period) * kSkeletonPeriodMs,
+      pose.tracked ? source.tracking_id : 0);
+  ++xbox360ps5::motion::guest_skeleton_frames;
+  if (pose.tracked) {
+    ++xbox360ps5::motion::guest_skeleton_bodies;
+  }
+  return X_E_SUCCESS;
+}
+
+void SkeletonGetNextFrameHandler(cpu::ppc::PPCContext* ppc_context,
+                                 KernelState* kernel_state) {
+  ppc_context->r[3] = uint32_t(SkeletonGetNextFrame(
+      kernel_state, uint32_t(ppc_context->r[3]), uint32_t(ppc_context->r[4])));
+}
+
+// Finds the title's NuiSkeletonGetNextFrame and has the guest run the handler
+// above in its place, the way an import is bound: "sc 2; blr" at its start and
+// an extern handler on the function. Done once, at the title's first camera
+// request, which is before it can have asked for a skeleton frame.
+void BindSkeletonSource(KernelState* kernel_state) {
+  static std::atomic<bool> tried{false};
+  if (tried.exchange(true)) {
+    return;
+  }
+  auto module = kernel_state->GetExecutableModule();
+  cpu::XexModule* xex = module ? module->xex_module() : nullptr;
+  if (!xex) {
+    return;
+  }
+  Memory* memory = kernel_state->memory();
+  const uint32_t base = xex->base_address();
+  const uint32_t size = xex->image_size();
+  if (!IsGuestRangeMapped(memory, base, size, false)) {
+    XELOGW("Virtual Kinect: the title's image is not all readable; its own "
+           "body tracking is kept");
+    return;
+  }
+  const std::vector<uint32_t> found =
+      xbox360ps5::motion::FindSkeletonGetNextFrame(
+          memory->TranslateVirtual(base), size, base);
+  if (found.size() != 1) {
+    XELOGW("Virtual Kinect: the skeleton frame function was not identified "
+           "({} candidates); the title keeps its own body tracking",
+           found.size());
+    return;
+  }
+  const uint32_t address = found[0];
+  cpu::Function* function = nullptr;
+  const cpu::Symbol::Status status = xex->DeclareFunction(address, &function);
+  if (!function || (status != cpu::Symbol::Status::kNew &&
+                    status != cpu::Symbol::Status::kDeclared)) {
+    XELOGW("Virtual Kinect: the skeleton frame function at {:08X} is already "
+           "compiled; the title keeps its own body tracking",
+           address);
+    return;
+  }
+  auto* heap = memory->LookupHeap(address);
+  uint32_t protection = 0;
+  const bool writable =
+      heap && heap->QueryProtect(address, &protection) &&
+      heap->Protect(address, 8, kMemoryProtectRead | kMemoryProtectWrite);
+  if (writable) {
+    // The handler is in place before the code that calls it can be compiled.
+    static_cast<cpu::GuestFunction*>(function)->SetupExtern(
+        SkeletonGetNextFrameHandler);
+    uint8_t* code = memory->TranslateVirtual(address);
+    xe::store_and_swap<uint32_t>(code + 0, 0x44000042);  // sc 2
+    xe::store_and_swap<uint32_t>(code + 4, 0x4E800020);  // blr
+    heap->Protect(address, 8, protection);
+    function->set_end_address(address + 4);
+  }
+  if (status == cpu::Symbol::Status::kNew) {
+    function->set_status(cpu::Symbol::Status::kDeclared);
+  }
+  if (!writable) {
+    XELOGW("Virtual Kinect: the skeleton frame function at {:08X} could not "
+           "be bound; the title keeps its own body tracking",
+           address);
+    return;
+  }
+  xbox360ps5::motion::guest_skeleton_bound = true;
+  XELOGW("Virtual Kinect: skeleton frames of the title come from the "
+         "estimated pose (function at {:08X})",
+         address);
+}

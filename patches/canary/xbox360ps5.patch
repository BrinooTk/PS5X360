diff --git a/src/xenia/kernel/xboxkrnl/xboxkrnl_pscam.cc b/src/xenia/kernel/xboxkrnl/xboxkrnl_pscam.cc
new file mode 100644
index 000000000..d5bef04aa
--- /dev/null
+++ b/src/xenia/kernel/xboxkrnl/xboxkrnl_pscam.cc
@@ -0,0 +1,913 @@
+/**

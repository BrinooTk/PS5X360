+// Read-only slices share an open guest file. This avoids copying a nested
+// Kinect data package (or a large DLC) into the PS5's limited malloc budget.
+class GuestFileMemory final : public MappedMemory {
+ public:
+  GuestFileMemory(std::shared_ptr<vfs::File> file, size_t offset, size_t size)
+      : file_(std::move(file)), offset_(offset) {
+    size_ = size;
+  }
+  bool ReadAt(size_t offset, void* buffer, size_t length) const override {
+    if (offset > size_ || length > size_ - offset || (!buffer && length)) {
+      return false;
+    }
+    if (!length) return true;
+    size_t read = 0;
+    const auto result = file_->ReadSync(
+        std::span<uint8_t>(static_cast<uint8_t*>(buffer), length),
+        offset_ + offset, &read);
+    return XSUCCEEDED(result) && read == length;
+  }
+  std::unique_ptr<MappedMemory> Slice(size_t offset, size_t length) override {
+    if (offset > size_ || length > size_ - offset) return nullptr;
+    return std::make_unique<GuestFileMemory>(file_, offset_ + offset, length);
+  }
+
+ private:
+  std::shared_ptr<vfs::File> file_;
+  size_t offset_;
+};
+
+std::unique_ptr<MappedMemory> MapGuestFile(vfs::Entry* entry) {
+  if (entry->can_map()) {
+    return entry->OpenMapped(MappedMemory::Mode::kRead, 0, 0);
+  }
+
+  vfs::File* file = nullptr;
+  const X_STATUS open_result =
+      entry->Open(vfs::FileAccess::kGenericRead, &file);
+  if (XFAILED(open_result)) {
+    XELOGE("{}: Cannot open {}: {:08X}", __func__, entry->path(), open_result);
+    return nullptr;
+  }
+
+  return std::make_unique<GuestFileMemory>(
+      std::shared_ptr<vfs::File>(file, [](vfs::File* value) { value->Destroy(); }),
+      0, entry->size());
+}
